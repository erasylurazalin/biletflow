# Copy to deploy/demo.env (gitignored) and fill in. Never commit the real file.
# Long random string, for example: openssl rand -base64 32
JWT_SECRET=
# Public address of the web app, used in emails and campaign QR links.
WEB_URL=https://example.com
# Password for every seeded demo account on this server.
SEED_PASSWORD=
# Loopback port the web app listens on, for the proxy in front of it.
WEB_PORT=3201
